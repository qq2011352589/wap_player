# ===== 免费AI（星火 spark-x2.5-1.7b）=====
# 若留空，框架会自动尝试从 ~/.local/share/opencode/auth.json 的 maas_xunfei.key 读取
MAAS_XUNFEI_API_KEY=
MAAS_XUNFEI_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
MAAS_XUNFEI_MODEL=spark-x2.5-1.7b

# ===== 游戏入口与账号（不再硬编码，请填自己的）=====
WAP_ENTRY_URL=http://fysg.n6game.cn/tdcq_player/index/
WAP_USERNAME=your_username
WAP_PASSWORD=your_password

# ===== 循环参数（可选）=====
# 最大步数，0=无限
LOOP_MAX_STEPS=0
# 最长运行分钟数，0=无限（CI 中用于在作业超时前优雅停止）
LOOP_MAX_RUNTIME_MINUTES=0
# 每步间隔（毫秒）
LOOP_STEP_DELAY_MS=800
# 连续停留同一页面的最大次数，0=禁用死循环检测
LOOP_MAX_REPEATED_URLS=5

# ===== 日志级别（可选）=====
# debug / info / warn / error / silent
LOG_LEVEL=info
